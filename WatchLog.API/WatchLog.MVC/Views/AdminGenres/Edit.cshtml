@using WatchLog.MVC.Models.ApiModels
@model GenreModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tür Düzenle: " + Model.Name;
}

<div class="admin-form-card" style="max-width: 600px; margin: 0 auto;">
    <form asp-controller="AdminGenres" asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-12">
                <label class="wl-form-label">Tür Adı *</label>
                <input type="text" name="name" class="wl-form-control" required value="@Model.Name" />
            </div>
        </div>

        <div class="d-flex gap-3 mt-4">
            <button type="submit" class="wl-btn-primary">
                <i class="fas fa-save me-2"></i>Güncelle
            </button>
            <a asp-controller="AdminGenres" asp-action="Index" class="wl-btn-outline">
                <i class="fas fa-times me-2"></i>İptal
            </a>
        </div>
    </form>
</div>
