@using WatchLog.MVC.Models.ApiModels
@model List<GenreModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Türler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div></div>
    <a asp-controller="AdminGenres" asp-action="Create" class="wl-btn-primary">
        <i class="fas fa-plus me-1"></i>Yeni Tür
    </a>
</div>

<div class="admin-table-card" style="max-width: 600px; margin: 0 auto;">
    <div class="admin-table-header">
        <h2 class="admin-table-title"><i class="fas fa-tags me-2 text-primary"></i>Tür Listesi</h2>
        <span class="text-muted ms-auto" style="font-size:.85rem;">@Model.Count tür</span>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tür Adı</th>
                    <th style="width: 100px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td>@g.Id</td>
                        <td><strong style="color:var(--cream)">@g.Name</strong></td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-controller="AdminGenres" asp-action="Edit" asp-route-id="@g.Id"
                                   class="btn-action btn-edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-controller="AdminGenres" asp-action="Delete" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@g.Id" />
                                    <button type="submit" class="btn-action btn-delete"
                                            onclick="return confirm('@g.Name türünü silmek istiyor musun?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
