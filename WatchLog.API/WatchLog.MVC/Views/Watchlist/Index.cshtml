@using WatchLog.MVC.Models.Entities
@model List<Watchlist>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "İzleme Listelerim";
}

<div class="wl-page-header">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1 class="wl-page-title"><i class="fas fa-list text-primary me-2"></i>İzleme Listelerim</h1>
                <p class="wl-page-subtitle">@Model.Count liste</p>
            </div>
            <a asp-controller="Watchlist" asp-action="Create" class="wl-btn-primary">
                <i class="fas fa-plus me-2"></i>Yeni Liste
            </a>
        </div>
    </div>
</div>

<div class="container py-4">
    @if (!Model.Any())
    {
        <div class="wl-empty">
            <i class="fas fa-list"></i>
            <h3>Henüz liste oluşturmadın</h3>
            <p>Filmleri ve dizileri organize etmek için liste oluştur.</p>
            <a asp-controller="Watchlist" asp-action="Create" class="wl-btn-primary mt-3">
                <i class="fas fa-plus me-2"></i>İlk Listeni Oluştur
            </a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var list in Model)
            {
                <div class="col-md-6">
                    <a class="wl-list-card" asp-controller="Watchlist" asp-action="Detail" asp-route-id="@list.Id">
                        <div class="wl-list-icon">
                            <i class="fas fa-list"></i>
                        </div>
                        <div style="flex:1;min-width:0;">
                            <div style="font-weight:600;color:var(--cream);margin-bottom:4px;">@list.Name</div>
                            @if (!string.IsNullOrEmpty(list.Description))
                            {
                                <div class="text-muted" style="font-size:.83rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                    @list.Description
                                </div>
                            }
                            <div class="d-flex align-items-center gap-3 mt-1">
                                <span class="text-muted" style="font-size:.78rem;">
                                    <i class="fas fa-film me-1"></i>@list.Items.Count(i => i.IsActive) içerik
                                </span>
                                @if (list.IsPublic)
                                {
                                    <span style="font-size:.72rem;background:rgba(34,197,94,.15);color:#22c55e;padding:2px 8px;border-radius:4px;">
                                        <i class="fas fa-globe me-1"></i>Herkese Açık
                                    </span>
                                }
                                <span class="text-muted" style="font-size:.78rem;">
                                    @list.CreatedAt.ToString("dd MMM yyyy")
                                </span>
                            </div>
                        </div>
                        <div class="d-flex flex-column gap-2">
                            <i class="fas fa-chevron-right text-muted"></i>
                            <form asp-controller="Watchlist" asp-action="Delete" method="post" onclick="event.stopPropagation()">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@list.Id" />
                                <button type="submit" class="btn btn-link text-danger p-0" style="font-size:.8rem;"
                                        onclick="return confirm('Listeyi silmek istiyor musun?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
