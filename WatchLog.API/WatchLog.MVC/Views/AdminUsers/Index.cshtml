@using WatchLog.MVC.Models.ViewModels
@model List<AdminUserViewModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Kullanıcılar";
}

<div class="admin-table-card">
    <div class="admin-table-header">
        <h2 class="admin-table-title"><i class="fas fa-users me-2 text-primary"></i>Kullanıcı Listesi</h2>
        <span class="text-muted ms-auto" style="font-size:.85rem;">@Model.Count kullanıcı</span>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Görünen Ad</th>
                    <th>E-posta</th>
                    <th>Rol</th>
                    <th>Durum</th>
                    <th>Kayıt Tarihi</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td><strong style="color:var(--cream)">@(u.DisplayName ?? "-")</strong></td>
                        <td>@u.Email</td>
                        <td>
                            @if (u.Role == "Admin")
                            {
                                <span style="font-size:.75rem;background:rgba(224,195,117,.15);color:var(--accent);padding:2px 8px;border-radius:4px;font-weight:600;">
                                    Admin
                                </span>
                            }
                            else
                            {
                                <span style="font-size:.75rem;background:rgba(255,255,255,.05);color:var(--text-muted);padding:2px 8px;border-radius:4px;">
                                    Kullanıcı
                                </span>
                            }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success" style="font-size:.7rem;">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-danger" style="font-size:.7rem;">Pasif</span>
                            }
                        </td>
                        <td>@u.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (u.IsActive && u.Role != "Admin")
                            {
                                <form asp-controller="AdminUsers" asp-action="Deactivate" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('@u.DisplayName kullanıcısını pasif yapmak istediğinize emin misiniz?')">
                                        <i class="fas fa-user-slash me-1"></i>Pasif Yap
                                    </button>
                                </form>
                            }
                            else if (!u.IsActive && u.Role != "Admin")
                            {
                                <form asp-controller="AdminUsers" asp-action="Activate" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success"
                                            onclick="return confirm('@u.DisplayName kullanıcısını aktif etmek istediğinize emin misiniz?')">
                                        <i class="fas fa-user-check me-1"></i>Aktif Yap
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size:.85rem;">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
