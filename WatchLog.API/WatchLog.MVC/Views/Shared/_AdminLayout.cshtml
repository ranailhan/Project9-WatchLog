<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin — @ViewData["Title"] | WatchLog</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">

<div class="admin-wrapper">
    <!-- Sidebar -->
    <aside class="admin-sidebar" id="adminSidebar">
        <div class="admin-sidebar-header">
            <a asp-controller="Dashboard" asp-action="Index" class="wl-logo">WATCH<span>LOG</span></a>
            <small class="text-muted d-block mt-1" style="font-size:.7rem;letter-spacing:.1em">ADMIN PANEL</small>
        </div>

        <nav class="admin-nav">
            <div class="admin-nav-section">Genel Bakış</div>
            <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
               asp-controller="Dashboard" asp-action="Index">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>

            <div class="admin-nav-section mt-3">İçerik</div>
            <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()?.Contains("Movie") == true ? "active" : "")"
               asp-controller="AdminMovies" asp-action="Index">
                <i class="fas fa-film"></i> Filmler
            </a>
            <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()?.Contains("Series") == true ? "active" : "")"
               asp-controller="AdminSeries" asp-action="Index">
                <i class="fas fa-tv"></i> Diziler
            </a>
            <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()?.Contains("Actor") == true ? "active" : "")"
               asp-controller="AdminActors" asp-action="Index">
                <i class="fas fa-user-friends"></i> Oyuncular
            </a>
            <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()?.Contains("Genre") == true ? "active" : "")"
               asp-controller="AdminGenres" asp-action="Index">
                <i class="fas fa-tags"></i> Türler
            </a>

            <div class="admin-nav-section mt-3">Kullanıcılar</div>
            <a class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()?.Contains("User") == true ? "active" : "")"
               asp-controller="AdminUsers" asp-action="Index">
                <i class="fas fa-users"></i> Kullanıcılar
            </a>

            <div class="admin-nav-section mt-3">Genel</div>
            <a class="admin-nav-link" asp-controller="Reports" asp-action="Index">
                <i class="fas fa-chart-bar"></i> Raporlar
            </a>
            <a class="admin-nav-link" asp-controller="Home" asp-action="Index">
                <i class="fas fa-home"></i> Siteye Dön
            </a>
        </nav>
    </aside>

    <!-- Main Area -->
    <div class="admin-content">
        <!-- Top Bar -->
        <header class="admin-topbar">
            <button class="btn btn-link text-muted d-lg-none" id="sidebarToggle">
                <i class="fas fa-bars"></i>
            </button>
            <h1 class="admin-page-title">@ViewData["Title"]</h1>
            <div class="ms-auto d-flex align-items-center gap-3">
                <span class="text-muted small">@User.Identity?.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-danger" type="submit">
                        <i class="fas fa-sign-out-alt me-1"></i>Çıkış
                    </button>
                </form>
            </div>
        </header>

        <!-- Toast -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mx-4 mt-3" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mx-4 mt-3" role="alert">
                <i class="fas fa-times-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="admin-body-content">
            @RenderBody()
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.getElementById('sidebarToggle')?.addEventListener('click', () => {
        document.getElementById('adminSidebar').classList.toggle('open');
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
