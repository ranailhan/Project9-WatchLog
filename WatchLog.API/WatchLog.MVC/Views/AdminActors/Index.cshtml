@using WatchLog.MVC.Models.ApiModels
@model List<ActorModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Oyuncular";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div></div>
    <a asp-controller="AdminActors" asp-action="Create" class="wl-btn-primary">
        <i class="fas fa-plus me-1"></i>Yeni Oyuncu
    </a>
</div>

<div class="admin-table-card">
    <div class="admin-table-header">
        <h2 class="admin-table-title"><i class="fas fa-user-friends me-2 text-primary"></i>Oyuncu Listesi</h2>
        <span class="text-muted ms-auto" style="font-size:.85rem;">@Model.Count oyuncu</span>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Fotoğraf</th>
                    <th>Ad Soyad</th>
                    <th>Doğum Tarihi</th>
                    <th>Uyruk</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(a.PhotoUrl))
                            {
                                <img src="@a.PhotoUrl" alt="@a.FullName" class="poster-thumb" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
                            }
                            else
                            {
                                <div style="width:36px;height:36px;background:var(--surface2);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--border);">
                                    <i class="fas fa-user" style="font-size:.8rem;"></i>
                                </div>
                            }
                        </td>
                        <td><strong style="color:var(--cream)">@a.FullName</strong></td>
                        <td>@(a.BirthDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td>@(a.Nationality ?? "-")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-controller="AdminActors" asp-action="Edit" asp-route-id="@a.Id"
                                   class="btn-action btn-edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-controller="AdminActors" asp-action="Delete" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <button type="submit" class="btn-action btn-delete"
                                            onclick="return confirm('@a.FullName oyuncusunu silmek istiyor musun?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
