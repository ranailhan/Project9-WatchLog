@using WatchLog.MVC.Models.ApiModels
@model List<MovieModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Filmler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div></div>
    <a asp-controller="AdminMovies" asp-action="Create" class="wl-btn-primary">
        <i class="fas fa-plus me-1"></i>Yeni Film
    </a>
</div>

<div class="admin-table-card">
    <div class="admin-table-header">
        <h2 class="admin-table-title"><i class="fas fa-film me-2 text-primary"></i>Film Listesi</h2>
        <span class="text-muted ms-auto" style="font-size:.85rem;">@Model.Count film</span>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Poster</th>
                    <th>Başlık</th>
                    <th>Yıl</th>
                    <th>Süre</th>
                    <th>Yönetmen</th>
                    <th>Türler</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(m.PosterUrl))
                            {
                                <img src="@m.PosterUrl" alt="@m.Title" class="poster-thumb" />
                            }
                            else
                            {
                                <div style="width:36px;height:50px;background:var(--surface2);border-radius:4px;display:flex;align-items:center;justify-content:center;color:var(--border);">
                                    <i class="fas fa-film" style="font-size:.8rem;"></i>
                                </div>
                            }
                        </td>
                        <td><strong style="color:var(--cream)">@m.Title</strong></td>
                        <td>@(m.ReleaseYear?.ToString() ?? "-")</td>
                        <td>@(m.Duration.HasValue ? $"{m.Duration} dk" : "-")</td>
                        <td>@(m.Director ?? "-")</td>
                        <td>
                            <span style="font-size:.8rem;color:var(--text-muted);">@(m.GenreNames ?? "-")</span>
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-controller="AdminMovies" asp-action="Edit" asp-route-id="@m.Id"
                                   class="btn-action btn-edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-controller="AdminMovies" asp-action="Delete" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <button type="submit" class="btn-action btn-delete"
                                            onclick="return confirm('@m.Title filmini silmek istiyor musun?')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
