@using WatchLog.MVC.Models.ApiModels
@model List<MovieModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Filmler";
    var genres = (ViewBag.Genres as List<GenreModel>) ?? new();
    var selectedGenre = ViewBag.SelectedGenre as int?;
}

<div class="wl-page-header">
    <div class="container">
        <h1 class="wl-page-title"><i class="fas fa-film text-primary me-2"></i>Filmler</h1>
        <p class="wl-page-subtitle">@Model.Count film listelendi</p>
    </div>
</div>

<div class="container py-4">
    <!-- Tür filtresi -->
    @if (genres.Any())
    {
        <div class="wl-filter-bar mb-4">
            <a asp-controller="Movies" asp-action="Index"
               class="wl-filter-pill @(selectedGenre == null ? "active" : "")">Tümü</a>
            @foreach (var g in genres)
            {
                <a asp-controller="Movies" asp-action="Index" asp-route-genreId="@g.Id"
                   class="wl-filter-pill @(selectedGenre == g.Id ? "active" : "")">@g.Name</a>
            }
        </div>
    }

    @if (!Model.Any())
    {
        <div class="wl-empty">
            <i class="fas fa-film"></i>
            <h3>Film bulunamadı</h3>
            <p>Farklı bir tür deneyin.</p>
        </div>
    }
    else
    {
        <div class="wl-grid">
            @foreach (var movie in Model)
            {
                <a class="wl-card" asp-controller="Movies" asp-action="Detail" asp-route-id="@movie.Id">
                    <div class="wl-card-poster">
                        @if (!string.IsNullOrEmpty(movie.PosterUrl))
                        {
                            <img src="@movie.PosterUrl" alt="@movie.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="wl-card-placeholder"><i class="fas fa-film"></i></div>
                        }
                        <div class="wl-card-overlay">
                            <div class="wl-card-overlay-actions">
                                <span class="wl-card-icon-btn"><i class="fas fa-info"></i></span>
                            </div>
                        </div>
                    </div>
                    <div class="wl-card-info">
                        <div class="wl-card-title">@movie.Title</div>
                        <div class="wl-card-meta">
                            @movie.ReleaseYear
                            @if (movie.Duration.HasValue)
                            {
                                <span> · @movie.Duration dk</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(movie.GenreNames))
                        {
                            <div class="wl-card-meta" style="font-size:.72rem;margin-top:2px;">
                                @movie.GenreNames
                            </div>
                        }
                    </div>
                </a>
            }
        </div>
    }
</div>
