@using WatchLog.MVC.Models.ApiModels
@using WatchLog.MVC.Models.Entities
@model MovieDetailModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Title;
    var reviews = ViewBag.Reviews as dynamic;
    var currentUserId = ViewBag.UserId as string;
    var watchlists = ViewBag.Watchlists as List<Watchlist> ?? new();
}

<!-- Hero -->
<div class="wl-detail-hero">
    <div class="wl-hero-backdrop" style="background-image:url('@Model.PosterUrl')"></div>
    <div class="wl-hero-overlay"></div>
</div>

<div class="container" style="margin-top:-60px; position:relative; z-index:5;">
    <div class="row g-4">
        <!-- Poster -->
        <div class="col-lg-3 col-md-4 d-none d-md-block">
            @if (!string.IsNullOrEmpty(Model.PosterUrl))
            {
                <img src="@Model.PosterUrl" alt="@Model.Title" class="img-fluid rounded-3 shadow"
                     style="width:100%;border:2px solid var(--border);" />
            }
        </div>

        <!-- Info -->
        <div class="col-lg-9 col-md-8">
            <div class="wl-detail-info">
                <!-- Başlık & Rating -->
                <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-3">
                    <div>
                        <h1 style="font-size:2rem;font-weight:800;color:var(--cream);margin-bottom:8px;">
                            @Model.Title
                        </h1>
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            @if (Model.ReleaseYear.HasValue)
                            {
                                <span class="text-muted">@Model.ReleaseYear</span>
                            }
                            @if (Model.Duration.HasValue)
                            {
                                <span class="text-muted">@Model.Duration dk</span>
                            }
                            @if (!string.IsNullOrEmpty(Model.Director))
                            {
                                <span class="text-muted">Yönetmen: <strong style="color:var(--cream)">@Model.Director</strong></span>
                            }
                        </div>
                    </div>
                    @if (Model.AverageRating.HasValue)
                    {
                        <div class="wl-rating-badge">
                            <i class="fas fa-star"></i>
                            @Model.AverageRating / 10
                            <small class="text-muted ms-1">(@Model.RatingCount oy)</small>
                        </div>
                    }
                </div>

                <!-- Türler -->
                @if (Model.Genres.Any())
                {
                    <div class="mb-3">
                        @foreach (var g in Model.Genres)
                        {
                            <a class="wl-genre-tag" asp-controller="Movies" asp-action="Index" asp-route-genreId="@g.Id">
                                @g.Name
                            </a>
                        }
                    </div>
                }

                <!-- Açıklama -->
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p style="color:rgba(255,255,255,.8);line-height:1.8;margin-bottom:1.5rem;">
                        @Model.Description
                    </p>
                }

                <!-- Eylemler -->
                <div class="d-flex gap-3 flex-wrap mb-4">
                    @if (!string.IsNullOrEmpty(Model.TrailerUrl))
                    {
                        <a href="@Model.TrailerUrl" target="_blank" class="wl-btn-primary">
                            <i class="fas fa-play"></i> Fragman İzle
                        </a>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- Favori -->
                        <form asp-controller="Favorites" asp-action="Toggle" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="contentId" value="@Model.Id" />
                            <input type="hidden" name="contentType" value="Movie" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="wl-btn-outline @(Model.IsFavorited ? "text-primary" : "")">
                                <i class="fas fa-heart @(Model.IsFavorited ? "text-primary" : "")"></i>
                                @(Model.IsFavorited ? "Favorilerde" : "Favoriye Ekle")
                            </button>
                        </form>

                        <!-- Listeye Ekle Dropdown -->
                        <div class="dropdown d-inline-block">
                            <button class="wl-btn-outline dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-plus me-1"></i> Listeye Ekle
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark wl-dropdown" style="max-height: 200px; overflow-y: auto;">
                                @if (watchlists.Any())
                                {
                                    @foreach (var wl in watchlists)
                                    {
                                        <li>
                                            <form asp-controller="Watchlist" asp-action="AddItem" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="watchlistId" value="@wl.Id" />
                                                <input type="hidden" name="contentId" value="@Model.Id" />
                                                <input type="hidden" name="contentType" value="Movie" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                <button type="submit" class="dropdown-item">@wl.Name</button>
                                            </form>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li><a class="dropdown-item disabled" href="#">Liste yok</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Watchlist" asp-action="Create">Yeni Liste Oluştur</a></li>
                                }
                            </ul>
                        </div>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="AdminMovies" asp-action="Edit" asp-route-id="@Model.Id"
                           class="wl-btn-outline" style="border-color:var(--accent);color:var(--accent);">
                            <i class="fas fa-edit"></i> Düzenle
                        </a>
                    }
                </div>

                <!-- Puan Ver -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="mb-4">
                        <p class="text-muted mb-2" style="font-size:.85rem;">
                            Puanın: @(Model.UserRating.HasValue ? $"{Model.UserRating}/10" : "Henüz puanlamadın")
                        </p>
                        <form asp-controller="Ratings" asp-action="Rate" method="post" class="d-flex align-items-center gap-2 flex-wrap">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="contentId"   value="@Model.Id" />
                            <input type="hidden" name="contentType" value="Movie" />
                            <input type="hidden" name="returnUrl"   value="@Context.Request.Path" />
                            <div class="wl-star-rating" id="starRating">
                                @for (int i = 1; i <= 10; i++)
                                {
                                    <button type="button" class="wl-star-btn @(Model.UserRating >= i ? "active" : "")"
                                            data-score="@i" onclick="setRating(@i)">★</button>
                                }
                            </div>
                            <input type="hidden" name="score" id="ratingScore" value="@(Model.UserRating ?? 0)" />
                            <button type="submit" class="wl-btn-primary" style="padding:6px 16px;font-size:.85rem;">
                                Puanla
                            </button>
                        </form>
                    </div>
                }

                <!-- Ekstra bilgi -->
                <div class="row g-2" style="font-size:.88rem;">
                    @if (!string.IsNullOrEmpty(Model.Country))
                    {
                        <div class="col-auto">
                            <span class="text-muted">Ülke:</span>
                            <strong style="color:var(--cream)">@Model.Country</strong>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Language))
                    {
                        <div class="col-auto">
                            <span class="text-muted">Dil:</span>
                            <strong style="color:var(--cream)">@Model.Language</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Oyuncular -->
    @if (Model.Actors.Any())
    {
        <div class="mt-4">
            <h3 style="font-size:1.2rem;font-weight:700;color:var(--cream);margin-bottom:1rem;">
                <i class="fas fa-users text-primary me-2"></i>Oyuncular
            </h3>
            <div class="row g-3">
                @foreach (var actor in Model.Actors)
                {
                    <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                        <div class="wl-actor-card">
                            @if (!string.IsNullOrEmpty(actor.PhotoUrl))
                            {
                                <img src="@actor.PhotoUrl" alt="@actor.FullName" />
                            }
                            else
                            {
                                <div style="height:140px;background:var(--surface2);display:flex;align-items:center;justify-content:center;font-size:2rem;color:var(--border);">
                                    <i class="fas fa-user"></i>
                                </div>
                            }
                            <div class="wl-actor-info">
                                <div class="wl-actor-name">@actor.FullName</div>
                                @if (!string.IsNullOrEmpty(actor.Nationality))
                                {
                                    <div class="wl-actor-nationality">@actor.Nationality</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Yorumlar -->
    <div class="mt-4 mb-5">
        <h3 style="font-size:1.2rem;font-weight:700;color:var(--cream);margin-bottom:1rem;">
            <i class="fas fa-comments text-primary me-2"></i>Yorumlar
        </h3>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="wl-review-form mb-4">
                <form asp-controller="Reviews" asp-action="Add" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="contentId"   value="@Model.Id" />
                    <input type="hidden" name="contentType" value="Movie" />
                    <input type="hidden" name="returnUrl"   value="@Context.Request.Path" />
                    <textarea name="text" placeholder="Bu film hakkında ne düşünüyorsun?" rows="3"></textarea>
                    <div class="text-end mt-2">
                        <button type="submit" class="wl-btn-primary" style="padding:8px 20px;">
                            <i class="fas fa-paper-plane me-1"></i>Yorum Gönder
                        </button>
                    </div>
                </form>
            </div>
        }

        @if (reviews != null)
        {
            @foreach (var r in reviews)
            {
                <div class="wl-review-card">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div>
                            <span class="wl-review-author">@r.UserName</span>
                            <span class="wl-review-date ms-2">@(((DateTime)r.CreatedAt).ToString("dd MMM yyyy"))</span>
                        </div>
                        @if (User.IsInRole("Admin") || (string)r.UserId == currentUserId)
                        {
                            <form asp-controller="Reviews" asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id"        value="@r.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                <button type="submit" class="btn btn-link text-danger p-0 btn-sm"
                                        onclick="return confirm('Yorumu silmek istiyor musun?')">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        }
                    </div>
                    <p class="wl-review-text">@r.Text</p>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
<script>
function setRating(score) {
    document.getElementById('ratingScore').value = score;
    document.querySelectorAll('.wl-star-btn').forEach((btn, i) => {
        btn.classList.toggle('active', i < score);
    });
}
document.querySelectorAll('.wl-star-btn').forEach(btn => {
    btn.addEventListener('mouseenter', function() {
        const s = parseInt(this.dataset.score);
        document.querySelectorAll('.wl-star-btn').forEach((b, i) => {
            b.style.color = i < s ? 'var(--accent)' : '';
        });
    });
});
document.getElementById('starRating')?.addEventListener('mouseleave', function() {
    const score = parseInt(document.getElementById('ratingScore').value);
    document.querySelectorAll('.wl-star-btn').forEach((b, i) => {
        b.style.color = '';
        b.classList.toggle('active', i < score);
    });
});
</script>
}
